{# vim: set ft=yaml: #}
kind: instance
name: foot-incus-ssh-tmux-osc52-poc
image: fedora-44-sklein-container-foot-incus-ssh-tmux-osc52-poc
profiles:
  - default
config:
  security.nesting: "true"
  cloud-init.user-data: |
    #cloud-config
    hostname: foot-incus-ssh-tmux-osc52-poc
    fqdn: foot-incus-ssh-tmux-osc52-poc.homelab.stephane-klein.info
    prefer_fqdn_over_hostname: true
    create_hostname_file: true
    write_files:
      - path: /tmp/netbird-setup-key
        content: {{ ENV.NETBIRD_SETUP_KEY }}
        permissions: "0600"
    runcmd:
      - [bash, /usr/local/sbin/enroll-netbird.sh, /tmp/netbird-setup-key]
    users:
      - name: fedora
        ssh_authorized_keys:
          - ssh-rsa  contact@stephane-klein.info
